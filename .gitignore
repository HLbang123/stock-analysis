# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# claude code local tooling config（本机环境相关，不提交）
/.claude/settings.json
/.claude/settings.local.json

# project temp files
.tmp/

# typescript
*.tsbuildinfo
next-env.d.ts

# 回测报告(服务器产物)
/backtest-report.*

# CodeGraph 索引(本地产物,8MB+,不入库)
/.codegraph/

# DSH agent-teams 团队状态(本地产物,不入库)
.agent-teams/

# docs/ 本地记忆与项目笔记（个人留存，不入库）
/docs/

# 一次性/临时脚本（scratch）：不入库，且被 tsconfig 排除出 next build 的类型检查。
# 缘由：2026-09-10 一次部署因 scripts/ 下的临时脚本依赖未提交代码，
# 而 next build 会 type-check scripts/**，导致生产构建失败。临时脚本一律放这里。
/scripts/_scratch/
