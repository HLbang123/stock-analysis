generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  tsCode   String  @id @map("ts_code") @db.VarChar(12)
  name     String  @db.VarChar(40)
  market   String  @db.VarChar(2)
  industry String? @db.VarChar(40)
  listDate String? @map("list_date") @db.VarChar(8)
  isActive Boolean @default(true) @map("is_active")

  dailyBars DailyBar[]
  rpsScores RpsScore[]

  @@map("stocks")
}

model DailyBar {
  tsCode    String @db.VarChar(12)
  tradeDate String @db.VarChar(8)
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  preClose  Float? @map("pre_close")
  changePct Float? @map("change_pct")
  vol       Float?
  amount    Float?
  turnoverRate Float? @map("turnover_rate")
  circMv    Float? @map("circ_mv")
  // tushare adj_factor（上市起累计复权因子）。OHLC 均为未复权原始价；
  // 窗口涨幅/均线/RPS 等多日计算须用 close*adj_factor 两端取值（后复权比率=真实收益），
  // 展示给用户的"最新价"仍用原始 close。
  adjFactor Float? @map("adj_factor")

  stock Stock @relation(fields: [tsCode], references: [tsCode])

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("daily_bars")
}

model RpsScore {
  tsCode   String @db.VarChar(12)
  calcDate String @db.VarChar(8)
  rps20    Float? @map("rps_20")
  rps60    Float? @map("rps_60")
  rps120   Float? @map("rps_120")
  rps250   Float? @map("rps_250")
  ret20    Float? @map("ret_20")
  ret60    Float? @map("ret_60")
  ret120   Float? @map("ret_120")
  ret250   Float? @map("ret_250")

  stock Stock @relation(fields: [tsCode], references: [tsCode])

  @@id([tsCode, calcDate])
  @@index([calcDate])
  @@index([calcDate, rps250(sort: Desc)])
  @@map("rps_scores")
}

// ===== 大盘页预计算表（均 snake_case 列名，raw SQL 裸用） =====

/// 市场宽度 + 占比（一行/交易日），由 compute-market-breadth 算
model MarketBreadth {
  tradeDate      String  @id @db.VarChar(8) @map("trade_date")
  advance        Int?
  decline        Int?
  flat           Int?
  limitUp        Int?    @map("limit_up")
  limitDown      Int?    @map("limit_down")
  newHigh20      Int?    @map("new_high20")
  newLow20       Int?    @map("new_low20")
  aboveMa55Count Int?    @map("above_ma55_count")
  aboveMa55Ratio Float?  @map("above_ma55_ratio")
  rpsImproveRatio Float? @map("rps_improve_ratio")

  @@map("market_breadth")
}

/// 吸筹箱体预计算（一行/标的/交易日，仅落 in_box 或 breakout 的行），由 compute-box 算
/// in_box/box_* 口径：窗口含当日（"当前在箱体内"状态）；breakout 口径：窗口不含当日 + 放量确认
model StockBox {
  tsCode     String  @db.VarChar(12) @map("ts_code")
  tradeDate  String  @db.VarChar(8)  @map("trade_date")
  inBox      Boolean @default(false) @map("in_box")
  boxQuality Float?  @map("box_quality")
  boxPos     Float?  @map("box_pos")
  boxTop     Float?  @map("box_top")
  boxBottom  Float?  @map("box_bottom")
  breakout   Boolean @default(false) // 收盘>箱顶×1.001 且 量≥1.6×箱均量 且 涨幅2~9.5%

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("stock_box")
}

/// 指数估值历史（6 大指数 × 多日），由 sync-index-valuation 拉
model IndexValuation {
  tsCode       String @db.VarChar(12) @map("ts_code")
  tradeDate    String @db.VarChar(8)  @map("trade_date")
  pe           Float?
  peTtm        Float? @map("pe_ttm")
  pb           Float?
  turnoverRate Float? @map("turnover_rate")

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("index_valuation")
}

/// 融资融券市场总量（一行/交易所/日），由 sync-margin 拉
model MarginTotal {
  tradeDate String @db.VarChar(8) @map("trade_date")
  exchange  String @db.VarChar(5) // SSE / SZSE
  rzye      Float? // 融资余额(元)
  rqye      Float? // 融券余额(元)
  rzmre     Float? // 融资买入额(元)
  rzche     Float? // 融资偿还额(元)
  rzrqye    Float? // 融资融券余额(元)

  @@id([tradeDate, exchange])
  @@index([tradeDate])
  @@map("margin_total")
}

/// 个股基本面（ROE 等，由 sync-fundamentals 同步）
model StockFundamental {
  tsCode            String  @id @db.VarChar(12) @map("ts_code")
  roe               Float?
  roa               Float?
  grossprofitMargin Float?  @map("grossprofit_margin")
  orYoy             Float?  @map("or_yoy")
  trYoy             Float?  @map("tr_yoy")
  period            String? @db.VarChar(8)

  @@map("stock_fundamentals")
}

/// 个股资金流向（按 trade_date 同步，用于板块聚合）
model StockMoneyflow {
  tsCode       String @db.VarChar(12) @map("ts_code")
  tradeDate    String @db.VarChar(8)  @map("trade_date")
  netMfAmount  Float? @map("net_mf_amount")  // 主力净流入(万元)
  buyElgAmount Float? @map("buy_elg_amount") // 超大单净流入(万元)
  buyLgAmount  Float? @map("buy_lg_amount")  // 大单净流入(万元)

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("stock_moneyflow")
}

/// 申万行业指数日线
model SwIndexDaily {
  tsCode    String @db.VarChar(12) @map("ts_code")
  tradeDate String @db.VarChar(8)  @map("trade_date")
  close     Float?
  pctChg    Float? @map("pct_chg")
  vol       Float?
  amount    Float?

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("sw_index_daily")
}

/// 申万行业成分股
model SwIndexMember {
  indexCode  String @db.VarChar(20) @map("index_code") // 行业指数代码
  indexName  String? @db.VarChar(40) @map("index_name") // 行业名称
  indexLevel String @db.VarChar(5) @map("index_level") // L1/L2/L3
  memberCode String @db.VarChar(12) @map("member_code") // 成分股代码
  memberName String? @db.VarChar(40) @map("member_name") // 成分股名称

  @@id([indexCode, memberCode, indexLevel])
  @@index([memberCode])
  @@index([indexLevel])
  @@map("sw_index_member")
}

// ===== AI 筛选（规则筛 + 因子打分 + LLM 重排 + 风险层）=====
// 对外文案一律称「筛选」，不出现选股/荐股字眼（合规口径）。
// Run/Pick 每次 T+N 回测埋点：entryPrice/entryDate 不可回填，exit* 字段供 Phase 3 回填。

/// 一次 AI 筛选运行
model AiScreenRun {
  id                String  @id @default(uuid()) @db.VarChar(36)
  strategyId        String  @map("strategy_id") @db.VarChar(32)
  strategyName      String  @map("strategy_name") @db.VarChar(40)
  createdAt         String  @map("created_at") @db.VarChar(32) // ISO
  barDate           String  @map("bar_date") @db.VarChar(8)
  rpsPeriod         Int     @map("rps_period")
  candidateCount    Int     @map("candidate_count")
  pickCount         Int     @map("pick_count")
  llmReranked       Boolean @default(false) @map("llm_reranked")
  llmRescued        Boolean @default(false) @map("llm_rescued") // 历史标记：此 run 是否曾由后续用户 token 补救升级成功（不再作熔断门控）
  llmRescuedAt      String? @map("llm_rescued_at") @db.VarChar(32) // 上次补救尝试时间(ISO)，10分钟冷却窗口用；null 表示从未试过补救
  llmModel          String? @map("llm_model") @db.VarChar(80)
  llmMarketView     String? @map("llm_market_view") @db.VarChar(300)
  llmSelectionLogic String? @map("llm_selection_logic") @db.VarChar(400)
  llmPortfolioRisk  String? @map("llm_portfolio_risk") @db.VarChar(400)
  llmCoverage       Float?  @map("llm_coverage")
  degradation       String[] // 降级日志
  riskEnabled       Boolean @default(true) @map("risk_enabled")
  portfolioEnabled  Boolean @default(false) @map("portfolio_enabled")
  marketRegime      String? @map("market_regime") @db.VarChar(12) // attack/neutral/defense 市场状态标记(只展示不拦截)

  picks AiScreenPick[]

  @@unique([strategyId, barDate])
  @@index([createdAt])
  @@index([strategyId])
  @@map("ai_screen_runs")
}

/// 一次运行中的单只候选(含因子分、LLM 理由、风险标签、T+N 埋点)。selected=true 为最终入选 top-N。
model AiScreenPick {
  id           String  @id @default(uuid()) @db.VarChar(36)
  runId        String  @map("run_id") @db.VarChar(36)
  selected     Boolean @default(false) @map("selected") // true=最终入选 top-N;false=候选池未入选(供 IC/A/B)
  rank         Int?    // 入选名次 1..N;未入选为 null
  tsCode       String  @map("ts_code") @db.VarChar(12)
  name         String  @db.VarChar(40)
  industry     String? @db.VarChar(40)

  // 快照
  rps           Float?
  latestClose   Float? @map("latest_close")
  latestChange  Float? @map("latest_change")
  latestAmount  Float? @map("latest_amount")
  // 技术特征
  ret60d              Float? @map("ret_60d")
  macdStatus          String? @map("macd_status") @db.VarChar(12)
  rsiStatus           String? @map("rsi_status") @db.VarChar(12)
  volatility20d       Float? @map("volatility_20d")
  maxDrawdown20d      Float? @map("max_drawdown_20d")
  atr20               Float? @map("atr_20")
  volumeRatio         Float? @map("volume_ratio")
  signalScore         Float? @map("signal_score")
  maBullish           Boolean? @map("ma_bullish")
  pullbackToMa20Pct   Float? @map("pullback_to_ma20_pct")
  breakout20dPct      Float? @map("breakout_20d_pct")
  // 基本面
  roe                 Float?
  grossprofitMargin   Float? @map("grossprofit_margin")
  orYoy               Float? @map("or_yoy")
  industryChangePct   Float? @map("industry_change_pct")
  // 分数
  factorScores        Json   @map("factor_scores")
  screenScore         Float  @map("screen_score")
  llmScore            Float? @map("llm_score")
  llmConfidence       Float? @map("llm_confidence")
  finalScore          Float  @map("final_score")
  // LLM 输出
  llmSector           String? @map("llm_sector") @db.VarChar(40)
  llmTheme            String? @map("llm_theme") @db.VarChar(100)
  llmThesis           String? @map("llm_thesis") @db.VarChar(240)
  rankingReason       String? @map("ranking_reason") @db.VarChar(200)
  riskSummary         String? @map("risk_summary") @db.VarChar(200)
  llmCatalysts        String[] @map("llm_catalysts")
  llmRisks            String[] @map("llm_risks")
  llmTags             String[] @map("llm_tags")
  llmStyleFit         String? @map("llm_style_fit") @db.VarChar(120)
  llmWatchItems       String[] @map("llm_watch_items")
  llmInvalidators     String[] @map("llm_invalidators")
  // 风险层
  riskScore           Float? @map("risk_score")
  riskLevel           String? @map("risk_level") @db.VarChar(8)
  riskPenalty         Float  @default(0) @map("risk_penalty")
  riskFlags           String[] @map("risk_flags")
  portfolioPenalty    Float  @default(0) @map("portfolio_penalty")
  // T+N 入选埋点(entryPrice/entryDate 必存;exit* 字段已废弃,改用 AiScreenEval 多持有期表)
  entryPrice          Float? @map("entry_price")
  entryDate           String? @map("entry_date") @db.VarChar(8)
  exitPrice           Float? @map("exit_price")
  exitDate            String? @map("exit_date") @db.VarChar(8)
  holdingReturnPct    Float? @map("holding_return_pct")
  evalNote            String? @map("eval_note") @db.VarChar(200)

  run  AiScreenRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  evals AiScreenEval[]

  @@index([runId])
  @@index([tsCode])
  @@index([entryDate])
  @@index([selected])
  @@map("ai_screen_picks")
}

/// T+N 多持有期回测评算(每 pick × 每持有期 N 一行)。回填脚本写入。
model AiScreenEval {
  id            String  @id @default(uuid()) @db.VarChar(36)
  pickId        String  @map("pick_id") @db.VarChar(36)
  nDays         Int     @map("n_days") // 1 / 5 / 20
  exitPrice     Float?  @map("exit_price")
  exitDate      String? @map("exit_date") @db.VarChar(8)
  returnPct     Float?  @map("return_pct") // (exitPrice/entryPrice - 1)*100 - costBps/100
  costBps       Float   @default(0) @map("cost_bps")
  shapeStatus   String? @map("shape_status") @db.VarChar(32) // breakout_follow_through / failed_breakout / ...
  maxDrawdownPct Float? @map("max_drawdown_pct")
  maxRunupPct   Float?  @map("max_runup_pct")
  pathStatus    String? @map("path_status") @db.VarChar(24)

  pick AiScreenPick @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@unique([pickId, nDays])
  @@index([nDays])
  @@map("ai_screen_evals")
}

/// 深度分析建议快照（全局匿名，按 股票+交易日+建议 去重，回测用）
model DeepAnalysisRecord {
  id          String  @id @default(uuid()) @db.VarChar(36)
  stockCode   String  @map("stock_code") @db.VarChar(12)
  stockName   String  @map("stock_name") @db.VarChar(40)
  entryDate   String  @map("entry_date") @db.VarChar(8) // YYYYMMDD 交易日
  entryPrice  Float   @map("entry_price")               // 用户跑时实时价（参考）
  action      String  @db.VarChar(8)                    // 买入/持有/卖出
  targetLow   Float?  @map("target_low")
  targetHigh  Float?  @map("target_high")
  stopLoss    Float?  @map("stop_loss")
  position    Float?
  confidence  Int?
  marketRegime String? @map("market_regime") @db.VarChar(8) // 分析时大盘环境 strong/neutral/weak（P3 环境分桶，旧数据为 NULL）
  reasoning   String? @db.VarChar(500)
  createdAt   String  @map("created_at") @db.VarChar(32) // ISO
  evals       DeepAnalysisEval[]

  @@unique([stockCode, entryDate, action])
  @@index([entryDate])
  @@map("deep_analysis_records")
}

/// 深度分析 T+N 回测结果（仿 AiScreenEval）
model DeepAnalysisEval {
  id              String  @id @default(uuid()) @db.VarChar(36)
  recordId        String  @map("record_id") @db.VarChar(36)
  nDays           Int     @map("n_days") // 5 / 10 / 20
  exitPrice       Float?  @map("exit_price")
  exitDate        String? @map("exit_date") @db.VarChar(8)
  returnPct       Float?  @map("return_pct") // (exitClose/entryClose - 1)*100 - cost
  maxDrawdownPct  Float?  @map("max_drawdown_pct")
  maxRunupPct     Float?  @map("max_runup_pct")
  pathStatus      String? @map("path_status") @db.VarChar(24)

  record DeepAnalysisRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, nDays])
  @@index([nDays])
  @@map("deep_analysis_evals")
}

/// 预警触发明细（在线落库 + 回放补历史）— 健康监控 / 周回顾 / 系数标定的数据地基
/// 同一触发 R01 阶梯可展开多行（extraData.triggered 各子信号一行）；T+N 由回填脚本补算
model AlertRuleTrigger {
  id        String  @id @default(uuid()) @db.VarChar(36)
  tsCode    String  @map("stock_code") @db.VarChar(12)
  stockName String? @map("stock_name") @db.VarChar(40)
  ruleId    String  @map("rule_id") @db.VarChar(8)    // R01/R02
  subLabel  String  @map("sub_label") @db.VarChar(24) // 巨量见顶/第二波见顶/...
  barDate   String  @map("bar_date") @db.VarChar(8)   // 触发日 YYYYMMDD
  createdAt String  @map("created_at") @db.VarChar(32)
  params    String? @db.VarChar(200)                  // 触发参数摘要(量比/比例, JSON), 回放补
  t5Return  Float?  @map("t5_return")
  t10Return Float?  @map("t10_return")
  source    String  @db.VarChar(8) @default("online") // online 在线 / replay 历史回放

  @@unique([tsCode, ruleId, subLabel, barDate, source])
  @@index([barDate])
  @@map("alert_rule_triggers")
}

/// 周回顾快照（周日 cron 生成，固定不随回填变化）— 弹窗/固定入口/未来推送共用单一事实源
model WeeklyReview {
  id        String @id @default(uuid()) @db.VarChar(36)
  weekStart String @map("week_start") @db.VarChar(8) // 周一 YYYYMMDD
  payload   String @db.Text                          // 完整周报 JSON
  createdAt String @map("created_at") @db.VarChar(32)

  @@unique([weekStart])
  @@map("weekly_reviews")
}

/// 波段评分(做T)信号在线落库 — 每次用户算评分顺手记一条（因子分口径），日内/隔日收益回填
/// 样本来源是真实使用（无历史分时可回放），攒够后做因子权重扫描
model TScoreRecord {
  id           String  @id @default(uuid()) @db.VarChar(36)
  tsCode       String  @map("stock_code") @db.VarChar(12) // sina 格式(sz002415)
  stockName    String? @map("stock_name") @db.VarChar(40)
  tradeDate    String  @map("trade_date") @db.VarChar(8)  // 当日 YYYYMMDD
  minuteOfDay  Int?    @map("minute_of_day")              // 信号时刻(分钟数, 630=10:30)
  price        Float?                                     // 信号时刻价格（回填日内收益的基准）
  buyScore     Float?  @map("buy_score")
  sellScore    Float?  @map("sell_score")
  buyFactors   String? @map("buy_factors")                // JSON [{name,score,raw}]
  sellFactors  String? @map("sell_factors")
  degraded     Boolean @default(false)
  createdAt    String  @map("created_at") @db.VarChar(32)
  intradayReturn Float? @map("intraday_return")           // 信号价 → 当日收盘
  nextDayReturn  Float? @map("next_day_return")           // 当日收盘 → 次日收盘

  @@unique([tsCode, tradeDate, minuteOfDay])
  @@index([tradeDate])
  @@map("tscore_records")
}

/// 同花顺指数（概念/行业，fuyao 源，sync-ths-index 维护；申万口径 sw_* 表并存）
model ThsIndex {
  thscode   String          @id @db.VarChar(12) // 886042.TI(概念) / 881101.TI(行业)
  name      String          @db.VarChar(50)
  tag       String          @db.VarChar(20) // cn_concept / industry
  members   ThsIndexMember[]
  updatedAt DateTime        @default(now()) @map("updated_at")

  @@map("ths_index")
}

/// 同花顺指数成分股（按指数全量覆盖式刷新；个股反查概念走 tsCode 索引）
model ThsIndexMember {
  thscode    String   @db.VarChar(12)
  tsCode     String   @map("ts_code") @db.VarChar(12)
  memberName String?  @map("member_name") @db.VarChar(40)

  index ThsIndex @relation(fields: [thscode], references: [thscode], onDelete: Cascade)

  @@id([thscode, tsCode])
  @@index([tsCode])
  @@map("ths_index_member")
}

/// 个股资金流向（同花顺 THS 口径，2026-08 起；旧东财口径 stock_moneyflow 保留历史不删）
model StockMoneyflowThs {
  tsCode        String  @map("ts_code") @db.VarChar(12)
  tradeDate     String  @map("trade_date") @db.VarChar(8)
  name          String? @db.VarChar(40)
  pctChange     Float?  @map("pct_change")
  latest        Float?
  netAmount     Float?  @map("net_amount")          // 资金净流入(万元)
  netD5Amount   Float?  @map("net_d5_amount")       // 5日主力净额(万元)
  buyElgAmount  Float?  @map("buy_elg_amount")      // 超大单净流入(万元)
  buyElgRate    Float?  @map("buy_elg_amount_rate") // 超大单净流入占比(%)
  buyLgAmount   Float?  @map("buy_lg_amount")       // 大单净流入(万元)
  buyLgRate     Float?  @map("buy_lg_amount_rate")  // 大单净流入占比(%)
  buyMdAmount   Float?  @map("buy_md_amount")
  buyMdRate     Float?  @map("buy_md_amount_rate")
  buySmAmount   Float?  @map("buy_sm_amount")
  buySmRate     Float?  @map("buy_sm_amount_rate")

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("stock_moneyflow_ths")
}

/// 行业资金流向（同花顺 THS 口径，大盘页行业资金数据源）
model IndustryMoneyflowThs {
  tsCode        String  @map("ts_code") @db.VarChar(12)
  tradeDate     String  @map("trade_date") @db.VarChar(8)
  industry      String? @db.VarChar(40)
  leadStock     String? @map("lead_stock") @db.VarChar(40)
  close         Float?
  pctChange     Float?  @map("pct_change")
  companyNum    Int?    @map("company_num")
  netBuyAmount  Float?  @map("net_buy_amount")  // 流入(亿元)
  netSellAmount Float?  @map("net_sell_amount") // 流出(亿元)
  netAmount     Float?  @map("net_amount")      // 净额(亿元)

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("industry_moneyflow_ths")
}

/// 基金日线（fund_daily：ETF 净值/份额，详情页 ETF 区净值趋势）
model FundDaily {
  tsCode    String  @map("ts_code") @db.VarChar(12)
  tradeDate String  @map("trade_date") @db.VarChar(8)
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  preClose  Float?  @map("pre_close")
  changePct Float?  @map("change_pct")
  vol       Float?
  amount    Float?

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("fund_daily_bars")
}

/// ETF 品种档案（tushare fund_basic + 派生分类，ETF 注册表唯一事实源）
/// assetClass/tPlus0/limitPct 由 lib/fund-classify.ts classifyFund 派生。
/// 后续若 tushare 积分到 8000，可加列 indexCode/totalSize/totalShare 后 backfill（etf_basic/etf_share_size）。
model FundProfile {
  tsCode     String  @id @map("ts_code") @db.VarChar(12) // 511880.SH
  name       String  @db.VarChar(40)
  fundType   String? @map("fund_type") @db.VarChar(20) // 股票型/债券型/混合型/货币型/另类投资型
  investType String? @map("invest_type") @db.VarChar(20) // 被动指数型/增强指数型
  benchmark  String? @db.VarChar(120) // 业绩基准文本
  listDate   String? @map("list_date") @db.VarChar(8)
  delistDate String? @map("delist_date") @db.VarChar(8)
  assetClass String? @map("asset_class") @db.VarChar(16) // 派生：equity/cross-border/bond/commodity/money
  tPlus0     Boolean @default(false) @map("t_plus0") // 派生：支持 T+0
  limitPct   Int?    @map("limit_pct") // 派生：10/20
  isActive   Boolean @default(true) @map("is_active")

  @@map("fund_profiles")
}

/// 涨跌停价（stk_limit，全市场每票每日精确涨停/跌停价，R01 封板/炸板判定用）
model StockLimit {
  tsCode    String  @map("ts_code") @db.VarChar(12)
  tradeDate String  @map("trade_date") @db.VarChar(8)
  preClose  Float?  @map("pre_close")
  limitUp   Float?  @map("limit_up")
  limitDown Float?  @map("limit_down")

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
  @@map("stock_limits")
}

/// 云同步快照（零知识）— sync_id 客户端随机 uuid；blob 为客户端 AES-GCM 密文（先 gzip）；
/// key_hash=sha256(syncKey)，写/删请求的 bearer 鉴权（脱库也推不出 syncKey）
model SyncSnapshot {
  syncId    String   @id @map("sync_id") @db.VarChar(36)
  keyHash   String   @map("key_hash") @db.VarChar(64)
  version   Int      @default(1)
  blob      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sync_snapshots")
}

/// 配对码（一次性，10 分钟 TTL）— code_hash=sha256(6位码)；wrapped_key 为配对码派生密钥加密的 syncKey
model SyncPairing {
  codeHash   String   @id @map("code_hash") @db.VarChar(64)
  syncId     String   @map("sync_id") @db.VarChar(36)
  wrappedKey String   @map("wrapped_key") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([syncId])
  @@map("sync_pairings")
}

/// 自选分享快照（明文；6 位分享码=读凭证，owner_token=写鉴权，读取免鉴权）
model ShareSnapshot {
  code        String   @id @db.VarChar(6)
  ownerToken  String   @map("owner_token") @db.VarChar(64)
  displayName String   @map("display_name") @db.VarChar(20)
  snapshot    String   @db.Text // JSON { groups: [{ name, stockCodes }] }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  expiresAt   DateTime? @map("expires_at") // null = 长期

  @@map("share_snapshots")
}

/// 分享订阅登记（订阅端本地随机 ID 去重；只记人数不记身份，供分享方看订阅数）
model ShareSubscriber {
  code         String   @db.VarChar(6)
  subscriberId String   @map("subscriber_id") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")
  lastSeenAt   DateTime @updatedAt @map("last_seen_at")

  @@id([code, subscriberId])
  @@index([code])
  @@map("share_subscribers")
}
